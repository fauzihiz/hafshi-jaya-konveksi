---
---
<section class="relative bg-slate-900 text-white overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-primary/80 to-slate-900/90 z-10"></div>
  <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1556228578-0d85b1a4d571?q=80&w=2000&auto=format&fit=crop')] bg-cover bg-center opacity-30 mix-blend-overlay"></div>
  
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 flex flex-col justify-center min-h-[85vh]">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent/10 border border-accent/30 text-accent font-medium text-sm mb-6 w-max">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent"></span>
      </span>
      Pabrik & Konveksi Seragam — Depok / Jabodetabek
    </div>
    
    <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold tracking-tight mb-6 max-w-4xl leading-tight">
      Mitra Pengadaan Seragam Terpercaya dengan <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-amber-300">Garansi Tepat Waktu</span>
    </h1>
    
    <p class="text-lg md:text-xl text-slate-300 mb-10 max-w-2xl leading-relaxed">
      Solusi konveksi profesional untuk pembuatan kemeja PDH/PDL, wearpack, kaos promosi, dan jaket custom dengan kualitas standar industri.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 mb-14">
      <a href="#contact" class="btn btn-primary btn-lg border-none bg-primary hover:bg-primary-hover text-white shadow-lg shadow-primary/20 rounded-full px-8">
        Konsultasi & Minta Penawaran
      </a>
      <a href="#" class="btn btn-outline btn-lg text-white border-white/30 hover:bg-white hover:text-slate-900 rounded-full px-8">
        Unduh Katalog Produk
      </a>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-8 border-t border-white/10 max-w-3xl">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <span class="text-sm font-medium text-slate-200">Garansi Tepat Waktu</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <span class="text-sm font-medium text-slate-200">Gratis Sampel & Mockup</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <span class="text-sm font-medium text-slate-200">Kirim Seluruh Indonesia</span>
      </div>
    </div>
  </div>
</section>
