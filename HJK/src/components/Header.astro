---
<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2">
          <img src="/logo.png" alt="Hafshi Jaya Konveksi Logo" class="h-10 w-auto" />
          <span class="font-bold text-xl text-primary hidden sm:block">Hafshi Jaya Konveksi</span>
        </a>
      </div>
      <nav class="hidden md:flex space-x-8">
        <a href="/" class="text-slate-600 hover:text-primary font-medium transition-colors">Beranda</a>
        <div class="dropdown dropdown-hover">
          <div tabindex="0" role="button" class="text-slate-600 hover:text-primary font-medium transition-colors m-1">Layanan</div>
          <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-52">
            <li><a href="/layanan/seragam-kerja">Seragam Kerja & PDH</a></li>
            <li><a href="/layanan/kaos-polo">Kaos & Polo Shirt</a></li>
            <li><a href="/layanan/jaket-outerwear">Jaket & Outerwear</a></li>
          </ul>
        </div>
        <a href="/tentang-kami" class="text-slate-600 hover:text-primary font-medium transition-colors">Tentang Kami</a>
      </nav>
      <div class="flex items-center gap-4">
        <a href="#contact" class="btn btn-primary btn-sm md:btn-md">Hubungi Kami</a>
        <div class="dropdown dropdown-end md:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
          </div>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
            <li><a href="/">Beranda</a></li>
            <li>
              <a>Layanan</a>
              <ul class="p-2">
                <li><a href="/layanan/seragam-kerja">Seragam Kerja & PDH</a></li>
                <li><a href="/layanan/kaos-polo">Kaos & Polo</a></li>
                <li><a href="/layanan/jaket-outerwear">Jaket & Outerwear</a></li>
              </ul>
            </li>
            <li><a href="/tentang-kami">Tentang Kami</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>
