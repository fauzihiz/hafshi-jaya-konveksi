<section class="py-24 bg-white" id="portfolio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Portofolio & Katalog Hasil Produksi</h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">Beberapa contoh hasil jahit produksi kami yang telah dipercaya oleh berbagai instansi dan perusahaan.</p>
    </div>
    
    {/* [HIDDEN] Filter tab disembunyikan sementara karena foto per kategori belum lengkap. Jika foto sudah ada, hapus class "hidden" di bawah */}
    <div class="hidden flex-wrap justify-center gap-2 mb-12">
      <button class="btn btn-sm md:btn-md btn-primary rounded-full px-6">Semua</button>
      <button class="btn btn-sm md:btn-md btn-outline border-slate-200 text-slate-600 hover:bg-slate-100 hover:text-slate-900 rounded-full px-6">Kemeja PDH/PDL</button>
      <button class="btn btn-sm md:btn-md btn-outline border-slate-200 text-slate-600 hover:bg-slate-100 hover:text-slate-900 rounded-full px-6">Polo Shirt</button>
      <button class="btn btn-sm md:btn-md btn-outline border-slate-200 text-slate-600 hover:bg-slate-100 hover:text-slate-900 rounded-full px-6">Jaket</button>
      <button class="btn btn-sm md:btn-md btn-outline border-slate-200 text-slate-600 hover:bg-slate-100 hover:text-slate-900 rounded-full px-6">Wearpack</button>
    </div>
    
    {/* Grid Gallery */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      {/* Portofolio Item 1 */}
      <div class="group relative overflow-hidden rounded-xl bg-slate-100 aspect-square border border-slate-200 cursor-pointer">
        <img src="/products/kemeja_depan.png" alt="Kemeja PDH" class="w-full h-full object-cover" />
        {/* [HIDDEN] Teks keterangan hover disembunyikan sementara. Hapus class "hidden" pada div di bawah jika ingin ditampilkan kembali */}
        <div class="hidden absolute inset-0 bg-slate-900/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex-col justify-end p-6 text-white">
          <h4 class="font-bold text-lg">Kemeja PDH Instansi</h4>
          <p class="text-sm text-slate-300">Bahan: Taipan Drill + Bordir Komputer</p>
        </div>
      </div>
      
      {/* Portofolio Item 2 */}
